<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Vendored legacy code written before nullable reference types. The consumer's
         Directory.Build.props enables them, which raised CS8601/CS8603/CS8618/CS8625 here.
         Suppressed per project rather than annotated (mapdojo/Apis.Bake#1012, mapdojo/MapManager#6). -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
    <Reference Include="gdal_csharp">
      <HintPath>..\..\Fork\Apis\Apis.Gdal.Sdk\bin\gdal\csharp\gdal_csharp.dll</HintPath>
    </Reference>
    <Reference Include="mapscript_csharp">
      <HintPath>..\..\Fork\Apis\Apis.Gdal.Sdk\bin\ms\csharp\mapscript_csharp.dll</HintPath>
    </Reference>
    <Reference Include="ogr_csharp">
      <HintPath>..\..\Fork\Apis\Apis.Gdal.Sdk\bin\gdal\csharp\ogr_csharp.dll</HintPath>
    </Reference>
    <Reference Include="osr_csharp">
      <HintPath>..\..\Fork\Apis\Apis.Gdal.Sdk\bin\gdal\csharp\osr_csharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <!-- Serilog comes from the consumer's Directory.Build.props; referencing it here too raised NU1504. -->
    <PackageReference Include="Microsoft.Win32.Registry" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
